{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "my-task-board": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/my-task-board",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "scripts": [],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "testing": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": false
            },
            "testing-backup": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": false,
              "styles": [],
              "assets": []
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "my-task-board:build:production"
            },
            "development": {
              "buildTarget": "my-task-board:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "my-task-board:build:testing",
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "runnerConfig": "vitest.config.mjs",
            "browsers": ["ChromiumHeadless"],
            "setupFiles": ["src/test-setup.ts"],
            "providersFile": "src/test-providers.ts"
          },
          "configurations": {
            "backup-check": {
              "buildTarget": "my-task-board:build:testing-backup",
              "tsConfig": "tsconfig.backup-spec.json",
              "include": [
                "src/app/providers/cloud-storage.provider.spec.ts",
                "src/app/core/storage/device-restore.spec.ts",
                "src/app/core/storage/checkpoint-recovery.spec.ts",
                "src/app/core/storage/workspace-merge.spec.ts",
                "src/app/account-bar/account-bar.component.spec.ts"
              ]
            }
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "2cc2e5b4-a168-438e-89a1-001436ef75f3"
  }
}
