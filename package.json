{
  "name": "my-task-board",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "config:backend": "node tools/generate-backend-config.mjs",
    "prestart": "npm run config:backend",
    "prebuild": "npm run config:backend",
    "prewatch": "npm run config:backend",
    "pretest": "npm run config:backend",
    "pretest:ci": "npm run config:backend",
    "test:config": "node --test tools/backend-config.test.mjs",
    "check:security-lock": "node tools/check-security-lock.mjs",
    "test:security-deps": "node --test tools/test-security-dependencies.mjs",
    "audit:security": "npm audit --package-lock-only",
    "audit:runtime": "npm audit --package-lock-only --omit=dev",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "preview": "node tools/serve-built.mjs --open",
    "watch": "ng build --watch --configuration development",
    "test": "node tools/run-angular-tests.mjs",
    "test:ci": "node tools/run-angular-tests.mjs --watch=false",
    "install:test-browser": "node tools/install-test-browser.mjs",
    "pretest:backup": "npm run config:backend",
    "test:backup": "node tools/run-angular-tests.mjs --configuration backup-check --watch=false",
    "test:admin": "node tools/test-admin-edge.mjs",
    "test:cloud-browser": "node tools/test-cloud-browser.mjs",
    "test:ux": "node tools/test-ux-browser.mjs",
    "test:cloud-http": "node tools/test-cloud-http.mjs",
    "serve:ssr:my-task-board": "node dist/my-task-board/server/server.mjs"
  },
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/platform-browser-dynamic": "21.2.25",
    "@angular/platform-server": "21.2.25",
    "@angular/router": "21.2.25",
    "@angular/service-worker": "21.2.25",
    "@angular/ssr": "21.2.26",
    "@supabase/supabase-js": "2.117.2",
    "@tailwindcss/postcss": "^4.1.5",
    "express": "^4.18.2",
    "postcss": "^8.5.3",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.5",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.26",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "21.2.25",
    "@types/express": "^4.17.17",
    "@types/node": "^22.0.0",
    "@vitest/browser-playwright": "4.1.11",
    "playwright": "1.64.0",
    "vitest": "4.1.11",
    "typescript": "5.9.3"
  },
  "overrides": {
    "http-cache-semantics": "4.3.0"
  }
}
